#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                      &kp N6  &kp N7  &kp N8         &kp N9   &kp N0    &kp RIGHT_BRACKET
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T                                       &kp Y   &kp U   &kp I          &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT    &kp A         &kp S         &kp D         &kp F         &kp G                                       &kp H   &kp J   &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z         &kp X         &kp C         &kp V         &kp B   &lt 6 LA(SPACE)    &lt 4 RG(SPACE)  &kp N   &kp M   &kp COMMA      &kp DOT  &kp FSLH  &kp BACKSPACE
                                              &kp LEFT_GUI  &kp LC(B)     &mo 2   &kp SPACE          &kp RET          &mo 1   &kp RIGHT_ALT   &kp RIGHT_GUI
            >;
        };

        symbol {
            bindings = <
&kp GRAVE    &kp LC(O)       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LC(I)         &kp QUESTION                                   &trans  &trans            &trans             &trans         &trans         &trans
&kp AT_SIGN  &kp LEFT_BRACE  &kp DOUBLE_QUOTES     &kp SQT                &kp RIGHT_BRACE   &kp TILDE                                      &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans         &trans         &trans
&kp HASH     &kp CARET       &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR        &kp ASTERISK                                   &trans  &trans            &trans             &trans         &trans         &trans
&kp EXCL     &kp LESS_THAN   &kp PIPE              &kp MINUS              &kp GREATER_THAN  &kp LC(R)             &lt 6 PERCENT    &trans  &trans  &trans            &trans             &trans         &trans         &trans
                                                   &kp AMPS               &kp PLUS          &kp BSLH              &kp COLON        &trans  &trans  &trans            &to 0
            >;
        };

        navigation {
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                    &hd_new_tab     &hd_next_tab    &hd_prev_tab    &hd_split_h    &hd_rename_tab &kp PRINTSCREEN
&trans  &trans        &trans        &trans            &trans          &trans                    &hd_focus_left  &hd_focus_down  &hd_focus_up  &hd_focus_right  &hd_close_tab  &hd_new_workspace
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                    &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT        &hd_goto       &hd_workspace_picker
&trans  &trans        &trans        &trans            &trans          &trans  &trans    &trans  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &hd_close_pane &kp DELETE
                                    &trans            &trans          &trans  &trans    &trans  &trans         &trans       &to 0
            >;
        };

        number {
            bindings = <
&trans  &trans        &trans        &trans                &trans                 &trans                    &kp TILDE     &kp CARET     &kp HASH      &kp DOLLAR    &kp AT_SIGN  &kp EXCLAMATION
&trans  &trans        &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                    &kp PRCNT     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp COLON    &kp LESS_THAN
&trans  &trans        &trans        &trans                &trans                 &trans                    &kp PLUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS    &kp GREATER_THAN
&trans  &trans        &trans        &trans                &trans                 &trans  &trans    &trans  &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH    &kp EQUAL
                                    &trans                &trans                 &trans  &trans    &trans  &kp NUMBER_0  &trans        &to 0
            >;
        };

        function {
            bindings = <
&trans  &trans  &kp F12  &kp F11  &kp F10  &trans                    &trans  &trans           &trans             &trans         &trans         &trans
&trans  &trans  &kp F9   &kp F8   &kp F7   &trans                    &trans  &trans           &trans             &trans         &trans         &trans
&trans  &trans  &kp F6   &kp F5   &kp F4   &trans                    &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &trans  &kp F3   &kp F2   &kp F1   &trans  &trans    &trans  &trans  &trans           &trans             &trans         &trans         &trans
                         &trans  &trans  &trans  &trans    &trans  &trans  &trans           &to 0
            >;
        };

        gaming {
            bindings = <
&trans            &kp N5  &kp N1  &kp N2  &kp N3        &kp N4                                   &trans  &trans  &trans  &trans    &trans          &trans
&kp TAB           &kp T   &kp Q   &kp W   &kp E         &kp R                                    &trans  &trans  &trans  &trans    &trans          &trans
&kp LEFT_SHIFT    &kp G   &kp A   &kp S   &kp D         &kp F                                    &trans  &trans  &trans  &trans    &kp UP_ARROW    &trans
&kp LEFT_CONTROL  &kp B   &kp Z   &kp X   &kp C         &kp V         &kp LEFT_CONTROL    &none  &trans  &trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT
                                  &kp F2      &kp F1    &kp LEFT_ALT  &kp SPACE           &trans  &trans  &trans  &to 0
            >;
        };

        controls {
            bindings = <
&studio_unlock  &trans        &trans        &trans            &trans          &trans                    &trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4
&trans          &trans        &trans        &trans            &trans          &trans                    &trans      &trans        &trans        &trans        &kp C_MUTE       &kp C_PLAY_PAUSE
&trans          &trans        &trans        &trans            &trans          &trans                    &trans      &to 4         &to 5         &to 6         &kp C_VOLUME_UP  &kp C_PREV
&bt BT_CLR      &trans        &trans        &trans            &trans          &trans  &trans    &trans  &trans      &to 1         &to 2         &to 3         &kp C_VOL_DN     &kp C_NEXT
                                            &trans            &trans          &trans  &trans    &trans  &trans      &trans        &to 0
            >;
        };
    };
};

/ {
    macros {
        hd_focus_left: hd_focus_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp H>;
        };

        hd_focus_down: hd_focus_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp J>;
        };

        hd_focus_up: hd_focus_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp K>;
        };

        hd_focus_right: hd_focus_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp L>;
        };

        hd_split_h: hd_split_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp MINUS>;
        };

        hd_new_tab: hd_new_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp C>;
        };

        hd_next_tab: hd_next_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N>;
        };

        hd_prev_tab: hd_prev_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp P>;
        };

        hd_close_tab: hd_close_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LS(X)>;
        };

        hd_rename_tab: hd_rename_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LS(T)>;
        };

        hd_new_workspace: hd_new_workspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LS(N)>;
        };

        hd_workspace_picker: hd_workspace_picker {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp W>;
        };

        hd_close_pane: hd_close_pane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp X>;
        };

        hd_goto: hd_goto {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp G>;
        };
    };
};
